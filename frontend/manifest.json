{
  "manifest_version": 3,
  "name": "YT RAG Chatbot",
  "version": "1.0",
  "description": "Chat with YouTube videos using RAG.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat with Video"
  }
}